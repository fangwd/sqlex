{
  "name": "sqlex",
  "version": "4.5.0",
  "description": "Typed ORM, migrations, and relation-aware database access for PostgreSQL, MySQL, and SQLite",
  "main": "./dist/index.js",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "require": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "examples",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "package.json",
    "README.md",
    "SECURITY.md"
  ],
  "types": "./dist/index.d.ts",
  "bin": {
    "sqlex": "./bin/sqlex.js",
    "sqlex-migrate": "./bin/sqlex-migrate.js"
  },
  "author": "Weidong Fang",
  "license": "MIT",
  "keywords": [
    "orm",
    "sql",
    "database",
    "typescript",
    "migrations",
    "postgresql",
    "mysql",
    "sqlite"
  ],
  "homepage": "https://github.com/fangwd/sqlex#readme",
  "bugs": {
    "url": "https://github.com/fangwd/sqlex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fangwd/sqlex.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jest": "^30.4.2",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "ranges-merge": "^9.0.15",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "test": "jest --runInBand --no-watchman",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc"
  }
}
