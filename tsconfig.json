{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2024",
    "types": [
      "node"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": [
      "es2024",
      "esnext.disposable"
    ],
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "noUncheckedSideEffectImports": true,
    "strict": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
